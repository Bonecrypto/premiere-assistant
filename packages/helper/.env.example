# Скопируйте этот файл в .env и заполните. .env не попадает в git.

# Ключ Anthropic API (https://platform.claude.com → API Keys). Хранится только здесь, в панель не передаётся.
ANTHROPIC_API_KEY=

# Модель Claude.
CLAUDE_MODEL=claude-opus-5-5

# Глубина рассуждений: low | medium | high | xhigh | max. Пусто — значение модели по умолчанию.
CLAUDE_EFFORT=medium

# Если модель откажется отвечать по соображениям безопасности, API сам повторит запрос
# на запасной модели (server-side fallback). off — выключить.
CLAUDE_FALLBACKS=default

# Порт WebSocket-сервера. Такой же порт должен быть указан в настройках панели.
HELPER_PORT=8765

# Дополнительные Origin, которым разрешено подключаться (через запятую).
# Нужен только для отладки панели в обычном браузере (vite dev).
HELPER_ALLOWED_ORIGINS=http://localhost:5173
