# Настройки помощника. Скопируйте в .env (или запустите помощника — он создаст .env сам).
# .env не попадает в git.

# Какая модель отвечает:
#   openrouter — бесплатные модели через OpenRouter (нужен только ключ, карта не нужна)
#   ollama     — локальная модель на вашем компьютере (без ключа и интернета)
#   gemini     — Google Gemini (бесплатный тариф)
#   claude     — Anthropic Claude (платно, по факту использования)
AI_PROVIDER=openrouter

# ── OpenRouter ──
# Ключ: openrouter.ai → Sign in → Keys → Create Key.
OPENROUTER_API_KEY=
# Модель. Пусто — помощник сам выберет бесплатные модели, умеющие вызывать инструменты.
# Можно указать свою или несколько через запятую (запасные на случай лимитов).
OPENROUTER_MODEL=

# ── Ollama (локально) ──
# Установите Ollama (ollama.com), затем в терминале: ollama pull qwen3:8b
OLLAMA_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434

# ── Gemini (Google) ──
# Ключ: aistudio.google.com → Get API key. Бесплатно, нужна только учётная запись Google.
GEMINI_API_KEY=
# Модель. Список доступных — на aistudio.google.com.
GEMINI_MODEL=gemini-2.5-flash

# ── Claude (Anthropic) ──
# Ключ: platform.claude.com → API Keys (нужно пополнить баланс).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Глубина рассуждений Claude: low | medium | high | xhigh | max.
CLAUDE_EFFORT=medium
# При отказе модели запрос повторяется на запасной модели. off — выключить.
CLAUDE_FALLBACKS=default

# Порт WebSocket-сервера. Такой же порт должен быть указан в настройках панели.
HELPER_PORT=8765

# Дополнительные Origin, которым разрешено подключаться (через запятую) —
# только для отладки панели в обычном браузере (vite dev).
HELPER_ALLOWED_ORIGINS=http://localhost:5173
