<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>com.premiereassistant.helper</string>
	<key>CFBundleName</key>
	<string>Premiere Assistant Helper</string>
	<key>CFBundleDisplayName</key>
	<string>Premiere Assistant Helper</string>
	<key>CFBundleExecutable</key>
	<string>premiere-assistant-helper</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<!-- Без значка в Dock: программа работает в фоне и сама закрывается после Premiere. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Панель запускает помощника ссылкой premiereassistant://start -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.premiereassistant.helper</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>premiereassistant</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
